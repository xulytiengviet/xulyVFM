{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "xulyvfm-convert",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "containers": [
    {
      "class_name": "VectorContainer",
      "image": "../backend-go/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 3,
      "constraints": { "regions": ["APAC"] }
    },
    {
      "class_name": "RasterContainer",
      "image": "../backend-go/Dockerfile",
      "instance_type": "standard-3",
      "max_instances": 2,
      "constraints": { "regions": ["APAC"] }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "VECTOR_CONTAINER", "class_name": "VectorContainer" },
      { "name": "RASTER_CONTAINER", "class_name": "RasterContainer" }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_sqlite_classes": ["VectorContainer", "RasterContainer"]
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://xulytiengviet.github.io",
    "MAX_STREAM_BYTES": "90000000"
  }
}
